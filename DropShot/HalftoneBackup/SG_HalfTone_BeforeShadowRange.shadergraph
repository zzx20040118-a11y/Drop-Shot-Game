{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "232f04a2d7c14de29c215d0c46e71fcc",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SimpleSpecular (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 2514.0,
            "y": 53.0,
            "width": 250,
            "height": 250
        }
    },
    "m_Slots": [
        {
            "m_Id": "b3d46cc63c954e45b6685ce4c34499dc"
        },
        {
            "m_Id": "fe46935a1728459ca61cea0afb7896d1"
        },
        {
            "m_Id": "7a1704d32d7b436bbd50ccf7b2b0d536"
        },
        {
            "m_Id": "e87c4e5ccf7c413abb2ec4541473aa32"
        },
        {
            "m_Id": "e4d13310c33f4deb91179cc4c7958884"
        },
        {
            "m_Id": "6e28b55a34244e93a4b964eca6d4e388"
        },
        {
            "m_Id": "0a62aca6d0b24003802a6cc9ac415352"
        },
        {
            "m_Id": "2ec1d4f4532a4c8b802f004bc113cdcf"
        },
        {
            "m_Id": "20355c3ff0eb45a6a7657819691c7cd4"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SimpleSpecular",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "float3 n = normalize(Normal);\nfloat3 v = GetWorldSpaceNormalizeViewDir(Position);\nfloat3 h = normalize(LightDirection + v + 0.00001);\nfloat s = saturate(Smoothness);\nfloat highlight = pow(saturate(dot(n,h)), exp2(3 + 8*s));\nfloat3 tint = lerp(float3(0.04,0.04,0.04), Base, saturate(Metallic));\nOut = tint * LightColor * highlight * (1 + 3*s)\n    * saturate(dot(n,LightDirection)) * Attenuation;"
}

